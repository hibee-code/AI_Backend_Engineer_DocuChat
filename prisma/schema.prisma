generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

// The connection URL lives in prisma.config.ts (Prisma 7 no longer reads it here)
datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("user")
  tier          String         @default("free")
  isActive      Boolean        @default(true)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documents     Document[]
  messages      Message[]
  conversations Conversation[]
  usageLogs     UsageLog[]
  refreshTokens RefreshToken[]
  roles         UserRole[]
  reviewsDone   ReviewQueue[] // Review items this user reviewed (as a reviewer)
}

model Document {
  id         String        @id @default(cuid())
  userId     String
  title      String
  filename   String?
  content    String
  status     String        @default("pending") // pending | processing | ready | failed
  chunkCount Int           @default(0)
  error      String? // Last processing error (set when status = failed)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks     Chunk[]
  messages   Message[]
  reviews    ReviewQueue[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

// A piece of a document, created by the document-processing worker.
model Chunk {
  id         String                       @id @default(cuid())
  documentId String
  index      Int // Position within the document (0-based)
  content    String
  tokenCount Int
  // mxbai-embed-large-v1 embeddings (1024 dims). Prisma can't read or
  // write this type, so embedding.service.ts uses raw SQL.
  // Its HNSW index (Chunk_embedding_idx) is created by raw-SQL migration and
  // `migrate dev` will try to drop it: always use --create-only and remove
  // any DROP INDEX "Chunk_embedding_idx" before applying.
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Message {
  id               String        @id @default(cuid())
  userId           String
  conversationId   String?
  documentId       String? // Set when the question was scoped to one document
  role             String // "user" | "assistant"
  content          String
  // Assistant messages only: LLM usage and RAG details (model, citations)
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal?      @db.Decimal(10, 6)
  metadata         Json?
  // Assistant messages only: retrieval confidence (0-1, confidence.service.ts)
  confidence       Float?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  document         Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviewQueue      ReviewQueue? // Set when the answer was escalated for human review

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

// Analytics / audit trail. userId is optional so failed logins for unknown emails can be recorded.
model UsageLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // "signup" | "login" | "login_failed" | ...
  tokens    Int      @default(0)
  costUsd   Decimal  @default(0) @db.Decimal(10, 6)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Refresh tokens are stored as SHA-256 hashes, never raw. Deleting a row revokes the token.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // SHA-256 hash of the actual token
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── RBAC: roles, permissions, and who has them ─────────────

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // 'admin', 'member', 'viewer'
  description String?
  isDefault   Boolean          @default(false) // New users get this role
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // 'documents:create'
  description String?
  resource    String // 'documents'
  action      String // 'create'
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String? // Who assigned this role (for audit)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// Incoming webhooks, keyed by the provider's event ID so a redelivered event
// is recognised as a duplicate (idempotency).
model WebhookEvent {
  id          String    @id // The provider's event ID
  provider    String // 'stripe', 'github', etc.
  eventType   String // 'payment.succeeded', etc.
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  payload     String // Raw payload for debugging
}

model PromptTemplate {
  id        String   @id @default(uuid())
  taskType  String // 'chat', 'agent', 'summary'
  version   String // 'v1', 'v2', 'v3'
  name      String // Human-readable name
  content   String // The actual prompt text
  isActive  Boolean  @default(false)
  metadata  String? // JSON: notes, author, changelog
  createdAt DateTime @default(now())

  @@unique([taskType, version])
  @@index([taskType, isActive])
}

// One row per AI call made through mcp.service.ts (mcpComplete).
// No relation to User on purpose: the audit trail outlives deleted users.
model AIAuditLog {
  id            String   @id @default(uuid())
  userId        String
  correlationId String
  taskType      String // 'chat', 'agent', 'summary'
  model         String
  promptVersion String
  inputTokens   Int
  outputTokens  Int
  costUsd       Decimal  @db.Decimal(10, 6) // Decimal like UsageLog: money in Float drifts
  latencyMs     Int
  fallbackUsed  Boolean  @default(false)
  // Store input/output as text, NOT in metadata JSON
  // This allows searching and analysis
  inputSummary  String // First 500 chars of the prompt (not full PII)
  outputSummary String // First 500 chars of the response
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskType, createdAt])
  @@index([model, createdAt])
}

// Human-in-the-loop review queue: low-confidence answers wait here for a
// reviewer (review-queue.service.ts). One item per assistant message; the
// answer stays hidden from the user until it's APPROVED.
model ReviewQueue {
  id              String         @id @default(cuid())
  messageId       String         @unique
  // Optional: a chat question can search all of the user's documents
  documentId      String?
  question        String
  generatedAnswer String         @db.Text
  confidence      Float
  sources         Json // Citations the answer was based on
  reason          String?
  status          ReviewStatus   @default(PENDING)
  priority        ReviewPriority @default(NORMAL)
  reviewedBy      String?
  editedAnswer    String?        @db.Text // Reviewer's corrected answer, if edited
  reviewerNotes   String?        @db.Text
  reviewedAt      DateTime?
  escalatedAt     DateTime?
  slaDeadline     DateTime // createdAt + HITL_SLA_MINUTES
  createdAt       DateTime       @default(now())
  // Deleting the message deletes its review; deleting the document or the
  // reviewer keeps the review record and just clears the link
  message         Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document        Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviewer        User?          @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt]) // Reviewer queue order
  @@index([reviewedBy])
  @@index([slaDeadline]) // Finding items past their SLA
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

enum ReviewPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
